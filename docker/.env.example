# Copy to /opt/crm-chatbot-ai/docker/.env on the server and fill in.
# NEVER commit the real .env. Only server-side values live here — every
# NEXT_PUBLIC_* variable is compiled into the image by the CI build args.

# Set automatically by the deploy workflow (exported before docker compose).
# Leave as :latest for a manual `docker compose up` on the server.
CHATBOT_IMAGE=annguyen11/crm-chatbot:latest

# Loopback port the Cloudflare Tunnel public hostname points at.
HTTP_PORT=8095

# Shared secret for the agent backend — must equal crm-agents `API_KEY`
# (see /opt/ai-crm/.env on the same server).
CHAT_API_KEY=

# Optional: only needed if you switch the chat route to call OpenAI directly
# instead of proxying to the agent backend.
OPENAI_API_KEY=

# Readonly demo: hides the approval/HITL composer prompt. Set only alongside
# crm-agents' COPILOT_DEMO_MODE=readonly (which is what actually stops the
# agent from proposing CRM Actions) — this flag by itself only removes the
# now-dead UI surface. NEXT_PUBLIC_*, so it is baked in at image build time.
NEXT_PUBLIC_COPILOT_DEMO_READONLY=false
